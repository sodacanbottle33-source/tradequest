{
  "name": "tradequest",
  "private": true,
  "version": "0.1.0",
  "description": "TradeQuest — a trading education simulator: a permanent shared fictional market with news, plus 1v1 battles.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "server": "tsx server/main.ts",
    "owner": "tsx tools/set-owner.ts",
    "reset-password": "tsx tools/reset-password.ts",
    "cloud": "tsx tools/cloud.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "bench:world": "tsx tools/bench-world.ts"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "tsx": "^4.19.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
